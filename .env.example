# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# DynamoDB
DYNAMODB_TABLE_NAME=erp-dashboard
DYNAMODB_REGION=eu-west-1
DYNAMODB_ENDPOINT=http://localhost:8000

# AWS (local dev only — production uses IAM role on ECS)
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=eu-west-1

# Auth
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Encryption (for API key storage)
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Default admin (seed script only)
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=change-me-on-first-login
